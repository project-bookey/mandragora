[Unit]
Description=Consistent Mandragora Farm database snapshot
After=mandragora.service

[Service]
Type=oneshot
User=mandragora
Group=mandragora
ExecStart=/usr/bin/python3.11 /opt/mandragora/current/server/backup.py
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mandragora
