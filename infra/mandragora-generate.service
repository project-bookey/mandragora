[Unit]
Description=Replenish Mandragora messages only when fewer than 30 remain
After=network-online.target mandragora.service
Wants=network-online.target

[Service]
Type=oneshot
User=mandragora
Group=mandragora
WorkingDirectory=/opt/mandragora/current
Environment=MANDRAGORA_MESSAGES_DB=/var/lib/mandragora/messages.sqlite3
EnvironmentFile=/etc/mandragora-ai.env
ExecStart=/opt/mandragora/node/bin/node infra/generate-messages.mjs
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mandragora
MemoryMax=128M
CPUQuota=50%
