[Unit]
Description=Mandragora Farm shared market API
After=network.target

[Service]
Type=simple
User=mandragora
Group=mandragora
WorkingDirectory=/opt/mandragora/current
Environment=MANDRAGORA_DB=/var/lib/mandragora/farm.sqlite3
Environment=MANDRAGORA_ORIGIN=https://www.bookey.site
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/mandragora/venv/bin/gunicorn --bind 127.0.0.1:3211 --workers 1 --threads 2 --timeout 30 --access-logfile - --error-logfile - server.app:application
Restart=on-failure
RestartSec=3
StateDirectory=mandragora
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mandragora
MemoryMax=96M
CPUQuota=75%

[Install]
WantedBy=multi-user.target
