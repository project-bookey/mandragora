# Node.js 24 이상. 기본 저장소는 로컬 SQLite입니다.
# 운영에서는 systemd가 /var/lib/mandragora/messages.sqlite3으로 지정합니다.
# MANDRAGORA_MESSAGES_DB=/absolute/path/messages.sqlite3

# AI 문구 보충 전용: 서버에서는 /etc/mandragora-ai.env에 설정합니다.
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b

# 하위 경로로 빌드할 때만 지정합니다. 로컬 기본값은 빈 경로입니다.
# NEXT_PUBLIC_BASE_PATH=/mandragora

# 선택: 세 변수를 모두 설정하면 기존 Supabase 저장소와 실시간 구독을 사용합니다.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
